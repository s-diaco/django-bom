{
  "name": "Lithium BoM (Postgres + sample data)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "user": "ubuntu",
  "install": "bash .cursor/scripts/cloud-agent-install.sh",
  "start": "bash .cursor/scripts/cloud-agent-start.sh",
  "terminals": [
    {
      "name": "web",
      "command": "bash .cursor/scripts/cloud-agent-runserver.sh",
      "description": "Django dev server (Postgres + restored dump) at http://localhost:8000"
    }
  ],
  "ports": [
    {
      "name": "web server",
      "port": 8000
    }
  ]
}
