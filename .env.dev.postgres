# Local (non-Docker) Postgres dev variant. Use this when you want to run the app
# against a real Postgres instance so you can restore a pg_dump of production data.
# The default dev path (.cursor/environment.json) uses SQLite and needs no Postgres.
#
# Load into your shell, then run the app:
#   set -a; . ./.env.dev.postgres; set +a
#   uv run python manage.py runserver
#
# Restore YOUR dump BEFORE first migrate (the dump already carries django_migrations):
#   gunzip < dump_bom_db.sql.gz | psql -h "$SQL_HOST" -U "$SQL_USER" -d "$SQL_DATABASE"
#   uv run python manage.py runserver   # applies only newer migrations, if any
#
# Requires a running Postgres with role/db created, e.g.:
#   createuser bom_user --pwprompt --superuser && createdb bom_db --owner bom_user
DEBUG=True
SECRET_KEY=dev-secret-key
DJANGO_ALLOWED_HOSTS="localhost 127.0.0.1 [::1]"
SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=bom_db
SQL_USER=bom_user
SQL_PASSWORD=bom_pass
SQL_HOST=127.0.0.1
SQL_PORT=5432
